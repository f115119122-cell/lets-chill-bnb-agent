# Copy this file to .env and put your own key after API_KEY=
# Never upload .env to GitHub.

## NKUST (key: https://www.iai.nkust.edu.tw/ , sign in with your NKUST Google account)
LLM_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
MODEL_NAME=Furen-large
API_KEY=

